# Copie para .env e preencha. Use só letras e números nas senhas
# (por exemplo, gere com: openssl rand -hex 24).

# Endereço do sistema, já apontado (DNS tipo A) para o IP da VPS.
DOMINIO=gynfinance.kodemi.pt

# Senha do administrador do banco (só a migração usa).
DB_ADMIN_PASSWORD=

# Senha do usuário do banco que o servidor usa no dia a dia.
APP_DB_PASSWORD=

# Porta do servidor dentro da VPS (127.0.0.1). Mude só se a 3000 já estiver em uso.
# PORTA_APP=3000

# E-mails que entram no painel de superadmin (/app/#/admin), separados por vírgula.
# Esses e-mails NÃO se cadastram pelo site (quem chegasse primeiro ganharia o painel).
# Conta que já existe continua valendo. Para criar uma nova ou trocar a senha:
#   docker compose run --rm -e NOME="Igor" -e EMAIL=igor@exemplo.com -e SENHA='senha-com-12+' app node server/src/criar-admin.ts
ADMIN_EMAILS=

# Provedor de e-mail (SMTP) para "Esqueci minha senha" e os lembretes do dia.
# Sem SMTP_HOST, o sistema funciona normalmente, só não manda e-mail.
# Porta 587 (STARTTLS) ou 465 (SSL).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Quem aparece como remetente, ex.: Gynfinance <avisos@kodemi.pt>
EMAIL_REMETENTE=
